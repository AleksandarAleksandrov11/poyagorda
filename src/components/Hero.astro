---
import Logo from './Logo.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__inner">
    <p class="eyebrow hero__eyebrow">Marketing con huevos.</p>
    <div class="hero__logo" data-hero-logo>
      <Logo size="xl" animate tag="h1" />
    </div>
    <p id="hero-title" class="hero__lead display">
      <span class="hero__line">Algo gordo se acerca.</span>
      <span class="hero__line y">Y tú, de momento, estás fuera.</span>
    </p>
    <div class="hero__actions">
      <a class="btn" href="#entrar" data-enter>Quiero entrar</a>
      <a class="hero__more" href="#verdad">Baja, que no muerde</a>
    </div>
  </div>
  <div class="hero__scroll" aria-hidden="true"><span></span></div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: calc(100svh - var(--header-h));
    padding: 24px 0 96px;
    overflow: hidden;
  }

  .hero__glow {
    position: absolute;
    left: 50%;
    top: 46%;
    width: min(120vw, 1100px);
    aspect-ratio: 1;
    translate: -50% -50%;
    background: radial-gradient(closest-side, rgb(249 222 49 / 0.09), rgb(249 222 49 / 0.02) 55%, transparent 72%);
    pointer-events: none;
    animation: glow-in 2.4s ease 2.2s both;
  }

  @keyframes glow-in {
    from {
      opacity: 0;
      scale: 0.6;
    }
  }

  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero__eyebrow {
    margin-bottom: clamp(18px, 3vw, 32px);
    animation: rise 0.9s var(--ease-out) 0.1s both;
  }

  .hero__logo {
    display: flex;
    justify-content: center;
    max-width: 100%;
  }

  .hero__lead {
    display: flex;
    flex-direction: column;
    gap: 0.12em;
    margin-top: clamp(26px, 4vw, 48px);
    font-size: clamp(22px, 3.4vw, 44px);
    font-stretch: 88%;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .hero__line {
    animation: rise 1s var(--ease-out) both;
  }

  .hero__line:nth-child(1) {
    animation-delay: 2.7s;
  }

  .hero__line:nth-child(2) {
    animation-delay: 3.05s;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px 26px;
    margin-top: clamp(30px, 4.5vw, 52px);
    animation: rise 1s var(--ease-out) 3.4s both;
  }

  .hero__more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .hero__more:hover {
    color: var(--yellow);
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 28px;
    width: 1px;
    height: 56px;
    background: var(--line);
    overflow: hidden;
    animation: rise 1s ease 3.8s both;
  }

  .hero__scroll span {
    position: absolute;
    inset: 0;
    background: var(--yellow);
    animation: scroll-line 2.2s cubic-bezier(0.7, 0, 0.3, 1) infinite;
  }

  @keyframes scroll-line {
    0% { transform: translateY(-100%); }
    60%, 100% { transform: translateY(100%); }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @media (max-height: 640px) {
    .hero__scroll {
      display: none;
    }
  }
</style>
