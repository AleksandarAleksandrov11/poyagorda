---
// Cada frase: [lo que crees, lo que no quieres oír]
const truths = [
  ['Tu negocio va bien.', 'O eso te gusta pensar.'],
  ['Tienes clientes.', 'Pero ¿cuántos no vuelven?'],
  ['Sabes lo que vendes.', '¿Pero sabes lo que te compran?'],
  ['Todo el mundo te da consejos.', 'Nadie se ha parado a mirar tu negocio.'],
];

// Promesas típicas de agencia. Salen sin tachar y se tachan al bajar.
const promises = [
  'Te prometemos resultados sin conocerte.',
  'Te vendemos lo que no necesitas.',
  'Te decimos lo que quieres oír.',
];
---

<section class="truth" id="verdad" aria-labelledby="truth-title">
  <div class="container">
    <p class="eyebrow truth__hint" id="truth-title">
      <span class="truth__hint-fine">Mueve el ratón. Aquí hay cosas que no quieres leer.</span>
      <span class="truth__hint-coarse">Toca la pantalla. Aquí hay cosas que no quieres leer.</span>
    </p>

    <div class="spot" data-spot>
      <div class="spot__beam" aria-hidden="true"></div>
      <ul class="spot__layer spot__base display" aria-hidden="true">
        {
          truths.map(([a, b], i) => (
            <li>
              <span class="spot__num">0{i + 1}</span>
              <span class="spot__a">{a}</span>
              <span class="spot__b">{b}</span>
            </li>
          ))
        }
      </ul>
      <ul class="spot__layer spot__lit display">
        {
          truths.map(([a, b], i) => (
            <li>
              <span class="spot__num" aria-hidden="true">0{i + 1}</span>
              <span class="spot__a">{a}</span>{' '}
              <span class="spot__b y">{b}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="manifesto">
      <p class="eyebrow">Lo que hacemos. Más o menos.</p>
      <ul class="manifesto__nope display">
        {promises.map((p) => <li data-strike><span>{p}</span></li>)}
      </ul>
      <p class="manifesto__yes display">
        Te auditamos el negocio y te decimos <span class="y">la puta verdad.</span>
      </p>
      <p class="manifesto__small">
        Qué te sobra, qué te falta y en qué no tienes que gastarte ni un euro más. Sin anestesia y sin gilipolleces.
        Lo demás, de momento, es secreto.
      </p>
    </div>
  </div>
</section>

<style>
  .truth {
    position: relative;
    overflow: clip;
    padding: clamp(80px, 12vw, 160px) 0 clamp(80px, 10vw, 140px);
  }

  .truth__hint {
    margin-bottom: clamp(24px, 4vw, 44px);
  }

  .truth__hint-coarse {
    display: none;
  }

  @media (hover: none) {
    .truth__hint-fine {
      display: none;
    }

    .truth__hint-coarse {
      display: inline;
    }
  }

  .spot {
    --x: 50%;
    --y: 0px;
    --r: 220px;
    position: relative;
    display: grid;
    cursor: crosshair;
    -webkit-tap-highlight-color: transparent;
  }

  .spot__layer {
    grid-area: 1 / 1;
    display: grid;
    gap: 0.62em;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: clamp(30px, 5.2vw, 76px);
    font-stretch: 74%;
    line-height: 0.95;
    letter-spacing: -0.025em;
  }

  .spot__layer li {
    display: grid;
    gap: 0.08em;
  }

  .spot__num {
    margin-bottom: 0.35em;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1;
  }

  .spot__lit .spot__num {
    color: var(--muted);
  }

  .spot__base {
    color: #0f0f0e;
  }

  .spot__lit {
    color: var(--white);
    -webkit-mask-image: radial-gradient(circle var(--r) at var(--x) var(--y), #000 0%, #000 30%, transparent 100%);
    mask-image: radial-gradient(circle var(--r) at var(--x) var(--y), #000 0%, #000 30%, transparent 100%);
  }

  .spot__beam {
    position: absolute;
    left: 0;
    top: 0;
    width: calc(var(--r) * 3.2);
    aspect-ratio: 1;
    border-radius: 50%;
    pointer-events: none;
    translate: calc(var(--x) - 50%) calc(var(--y) - 50%);
    background: radial-gradient(closest-side, rgb(249 222 49 / 0.075), rgb(249 222 49 / 0.02) 55%, transparent);
  }

  .spot--all .spot__beam {
    display: none;
  }

  .spot--all .spot__lit {
    -webkit-mask-image: none;
    mask-image: none;
  }

  .manifesto {
    margin-top: clamp(90px, 14vw, 180px);
    max-width: 1000px;
  }

  .manifesto__nope {
    display: grid;
    gap: 0.32em;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
    font-size: clamp(30px, 4.6vw, 64px);
    font-stretch: 92%;
    line-height: 0.98;
  }

  /* Al principio se leen como promesas. Al bajar, una línea amarilla las cruza
     (se traza de izquierda a derecha, línea a línea) y el texto se apaga y se vuelve translúcido
     para que el tachado se vea entero a través de las letras. */
  .manifesto__nope span {
    color: var(--white);
    background-image: linear-gradient(var(--yellow), var(--yellow));
    background-repeat: no-repeat;
    background-position: 0 55%;
    background-size: 0% 0.09em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    transition:
      background-size 0.75s var(--ease-out),
      color 0.6s ease 0.2s;
  }

  .manifesto__nope li.is-struck span {
    color: rgb(243 242 236 / 0.16);
    background-size: 100% 0.09em;
  }

  .manifesto__yes {
    margin-top: clamp(28px, 4vw, 44px);
    font-size: clamp(30px, 4.6vw, 64px);
    font-stretch: 92%;
    line-height: 0.98;
  }

  .manifesto__small {
    max-width: 560px;
    margin-top: 24px;
    color: var(--muted);
    font-size: clamp(16px, 1.25vw, 19px);
  }
</style>

<script>
  const spot = document.querySelector<HTMLElement>('[data-spot]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (spot && reduce) {
    spot.classList.add('spot--all');
  } else if (spot) {
    let rect = spot.getBoundingClientRect();
    let target = { x: rect.width / 2, y: 0 };
    let pos = { ...target };
    let lastManual = -Infinity;
    let pointer = { x: 0, y: 0 };
    let mouseInside = false;
    let running = false;
    let raf = 0;

    const measure = () => {
      rect = spot.getBoundingClientRect();
      const r = Math.round(Math.min(280, Math.max(130, rect.width * 0.24)));
      spot.style.setProperty('--r', `${r}px`);
    };

    const setManual = (clientX: number, clientY: number) => {
      pointer = { x: clientX, y: clientY };
      lastManual = performance.now();
    };

    spot.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'mouse' || e.pointerType === 'pen') setManual(e.clientX, e.clientY);
    });
    spot.addEventListener('pointerdown', (e) => setManual(e.clientX, e.clientY));
    spot.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse') mouseInside = true;
    });
    spot.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse') mouseInside = false;
    });

    const tick = (t: number) => {
      rect = spot.getBoundingClientRect();
      if (mouseInside || t - lastManual <= 2200) {
        // Coordenadas de pantalla: si haces scroll con el ratón quieto, la luz se queda donde apuntas.
        target = { x: pointer.x - rect.left, y: pointer.y - rect.top };
      } else {
        // Modo automático: la linterna baja con el scroll y se pasea a lo ancho.
        const vh = window.innerHeight;
        const progress = Math.min(1, Math.max(0, (vh * 0.62 - rect.top) / rect.height));
        target = {
          x: rect.width * (0.5 + Math.sin(t / 900) * 0.36),
          y: rect.height * progress + Math.sin(t / 650) * 18,
        };
      }
      pos.x += (target.x - pos.x) * 0.12;
      pos.y += (target.y - pos.y) * 0.12;
      spot.style.setProperty('--x', `${pos.x.toFixed(1)}px`);
      spot.style.setProperty('--y', `${pos.y.toFixed(1)}px`);
      if (running) raf = requestAnimationFrame(tick);
    };

    measure();
    window.addEventListener('resize', measure, { passive: true });

    new IntersectionObserver(([entry]) => {
      running = entry.isIntersecting;
      cancelAnimationFrame(raf);
      if (running) raf = requestAnimationFrame(tick);
    }).observe(spot);
  }

  // Cada promesa se tacha cuando llega a media pantalla, de una en una.
  const strikes = Array.from(document.querySelectorAll<HTMLElement>('[data-strike]'));
  let nextAt = 0;
  const strike = (el: HTMLElement) => {
    const now = performance.now();
    const wait = Math.max(0, nextAt - now);
    nextAt = Math.max(now, nextAt) + 450;
    setTimeout(() => el.classList.add('is-struck'), wait);
  };
  if (strikes.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            io.unobserve(e.target);
            strike(e.target as HTMLElement);
          }
        });
      },
      { rootMargin: '0px 0px -45% 0px' },
    );
    strikes.forEach((el) => io.observe(el));
  } else {
    strikes.forEach((el) => el.classList.add('is-struck'));
  }
</script>
