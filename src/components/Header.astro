---
import Logo from './Logo.astro';
import { brand } from '../config/site';

interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
---

<header class:list={['site-header', { 'site-header--home': home }]} data-header>
  <div class="site-header__inner">
    <a href="/" class="site-header__logo" aria-label="POYAGORDA, ir al inicio">
      <Logo size="sm" />
    </a>
    <nav class="site-header__nav" aria-label="Principal">
      <a
        class="site-header__ig"
        href={brand.instagram}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Instagram ${brand.instagramHandle} (se abre en otra pestaña)`}
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="3" y="3" width="18" height="18" rx="5"></rect>
          <circle cx="12" cy="12" r="4.2"></circle>
          <circle cx="17.4" cy="6.6" r="0.6" fill="currentColor" stroke="none"></circle>
        </svg>
        <span class="site-header__handle">{brand.instagramHandle}</span>
      </a>
      <a class="btn site-header__cta" href="/#entrar" data-enter>Entrar</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  .site-header.is-scrolled {
    background: rgb(5 5 5 / 0.72);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
    box-shadow: 0 1px 0 var(--line);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 100%;
    padding-inline: var(--gutter);
    padding-top: env(safe-area-inset-top, 0);
  }

  .site-header__logo {
    text-decoration: none;
    transition: opacity 0.4s ease, transform 0.4s var(--ease-out);
  }

  /* En la home el logo pequeño aparece cuando el grande se va. */
  .site-header--home .site-header__logo {
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
  }

  .site-header--home.show-logo .site-header__logo {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: clamp(12px, 2.5vw, 28px);
  }

  .site-header__ig {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 13px;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .site-header__ig:hover {
    color: var(--yellow);
  }

  .site-header__cta {
    min-height: 40px;
    padding: 0 18px;
    font-size: 13px;
  }

  @media (max-width: 380px) {
    .site-header__logo :global(.logo--sm) {
      font-size: 18px;
    }

    .site-header__cta {
      padding: 0 14px;
    }

    .site-header__nav {
      gap: 6px;
    }
  }

  @media (max-width: 640px) {
    .site-header__handle {
      display: none;
    }

    .site-header__ig {
      min-width: 44px;
      justify-content: center;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 12);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    const heroLogo = document.querySelector('[data-hero-logo]');
    if (heroLogo && 'IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        header.classList.toggle('show-logo', !entry.isIntersecting);
      }, { rootMargin: '-64px 0px 0px 0px' }).observe(heroLogo);
    } else {
      header.classList.add('show-logo');
    }
  }
</script>
