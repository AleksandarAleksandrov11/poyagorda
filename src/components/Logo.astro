---
interface Props {
  size?: 'sm' | 'xl';
  animate?: boolean;
  tag?: 'span' | 'h1';
}
const { size = 'sm', animate = false, tag: Tag = 'span' } = Astro.props;
const letters = 'POYAGORDA'.split('');
---

<Tag class:list={['logo', `logo--${size}`, { 'logo--anim': animate }]} data-logo>
  {
    Tag === 'h1' ? (
      <>
        <span class="logo__word">
          {letters.map((l) => <span class="logo__l">{l}</span>)}
        </span>
        <span class="logo__dot" aria-hidden="true" data-logo-dot />
        <span class="sr-only">. Marketing con huevos.</span>
      </>
    ) : (
      <>
        <span class="sr-only">POYAGORDA.</span>
        <span class="logo__word" aria-hidden="true">
          {letters.map((l) => <span class="logo__l">{l}</span>)}
        </span>
        <span class="logo__dot" aria-hidden="true" data-logo-dot />
      </>
    )
  }
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: baseline;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 100%;
    letter-spacing: -0.055em;
    line-height: 0.85;
    color: var(--white);
    white-space: nowrap;
    user-select: none;
  }

  .logo--sm {
    font-size: 22px;
  }

  .logo--xl {
    --st: 112%;
    font-size: min(calc((100vw - 2 * var(--gutter)) / 7.7), 240px);
    font-stretch: var(--st);
    letter-spacing: -0.06em;
    transition: font-stretch 0.7s var(--ease-out), letter-spacing 0.7s var(--ease-out);
  }

  /* Que engorde al pasar por encima. El nombre obliga. */
  @media (hover: hover) {
    .logo--xl {
      --st: 106%;
      font-size: min(calc((100vw - 2 * var(--gutter)) / 8.2), 230px);
    }

    .logo--xl:hover {
      font-stretch: 125%;
      letter-spacing: -0.09em;
    }
  }

  .logo__word {
    display: inline-flex;
  }

  .logo__l {
    --i: 0;
    display: inline-block;
  }

  .logo__l:nth-child(2) { --i: 1; }
  .logo__l:nth-child(3) { --i: 2; }
  .logo__l:nth-child(4) { --i: 3; }
  .logo__l:nth-child(5) { --i: 4; }
  .logo__l:nth-child(6) { --i: 5; }
  .logo__l:nth-child(7) { --i: 6; }
  .logo__l:nth-child(8) { --i: 7; }
  .logo__l:nth-child(9) { --i: 8; }

  .logo__dot {
    display: inline-block;
    width: 0.2em;
    height: 0.2em;
    margin-left: 0.05em;
    border-radius: 50%;
    background: var(--yellow);
    flex: none;
  }

  /* Intro: letras que parpadean como un neón jodido, punto que cae y rebota. */
  .logo--anim .logo__l {
    opacity: 0;
    animation: flicker 1.1s steps(1, end) forwards;
    animation-delay: calc(0.25s + var(--i) * 0.07s + (var(--i) * var(--i)) * 0.004s);
  }

  .logo--anim .logo__word {
    animation: inflate 1.4s var(--ease-out) 1.25s backwards;
  }

  .logo--anim .logo__dot {
    animation:
      drop 0.9s cubic-bezier(0.5, 0, 0.75, 0) 1.55s both,
      bounce 0.6s var(--ease-out) 2.45s forwards,
      pulse 3.2s ease-in-out 3.4s infinite;
  }

  @keyframes flicker {
    0% { opacity: 0; }
    10% { opacity: 1; }
    18% { opacity: 0.15; }
    28% { opacity: 1; }
    36% { opacity: 0.3; }
    44% { opacity: 1; }
    100% { opacity: 1; }
  }

  @keyframes inflate {
    from {
      font-stretch: 62%;
      letter-spacing: -0.02em;
    }
    to {
      font-stretch: var(--st);
      letter-spacing: -0.06em;
    }
  }

  @keyframes drop {
    from {
      transform: translateY(-110vh);
    }
    to {
      transform: translateY(0) scale(1.35, 0.6);
    }
  }

  @keyframes bounce {
    0% { transform: translateY(0) scale(1.35, 0.6); }
    40% { transform: translateY(-0.45em) scale(0.9, 1.15); }
    70% { transform: translateY(0) scale(1.1, 0.9); }
    100% { transform: translateY(0) scale(1); }
  }

  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgb(249 222 49 / 0); }
    50% { box-shadow: 0 0 0.35em 0.06em rgb(249 222 49 / 0.45); }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo--anim .logo__l,
    .logo--anim .logo__word,
    .logo--anim .logo__dot {
      animation: none;
      opacity: 1;
    }
  }
</style>
