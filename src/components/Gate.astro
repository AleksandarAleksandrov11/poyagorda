---
import { legal, newsletterProcessor, CONSENT_VERSION } from '../config/site';
---

<section class="gate" id="puerta" aria-labelledby="gate-title">
  <div class="container gate__inner">
    <header class="gate__head">
      <p class="eyebrow">La puerta.</p>
      <h2 id="gate-title" class="display gate__title">
        Responde.<br /><span class="y">Sin mentir, que se te nota.</span>
      </h2>
      <p class="gate__sub">
        Responde, déjanos tu email y serás de los primeros en enterarte de qué cojones es esto. Si no, pues nada, sigue
        con tu vida.
      </p>
    </header>

    <div class="term" id="entrar" data-term data-consent-version={CONSENT_VERSION}>
      <div class="term__top">
        <span class="term__path">poyagorda://acceso-restringido</span>
        <button type="button" class="term__reset" data-reset hidden>Empezar de nuevo</button>
      </div>
      <div class="term__screen" data-screen>
        <div class="term__log" data-log aria-hidden="true"></div>
        <div class="sr-only" data-sr role="log" aria-live="polite"></div>
        <div class="term__controls" data-controls>
          <button type="button" class="term__boot" data-boot>
            <span class="y">&gt;</span> Pulsa para entrar<span class="term__caret" aria-hidden="true"></span>
          </button>
        </div>
      </div>
      <noscript>
        <p class="term__noscript">Sin JavaScript esto no funciona. Actívalo, que no muerde.</p>
      </noscript>
    </div>
  </div>

  <template data-tpl="consent">
    <form class="term__consent" novalidate>
      <div class="t-form term__email" data-email-row hidden>
        <label class="t-form__prompt" for="t-in-email-short"><span aria-hidden="true">&gt;</span><span class="sr-only">Tu email</span></label>
        <input
          id="t-in-email-short"
          type="email"
          name="email"
          inputmode="email"
          autocomplete="email"
          autocapitalize="off"
          spellcheck="false"
          maxlength="254"
          enterkeyhint="send"
          placeholder="Tu correo electrónico"
        />
      </div>
      <label class="term__check">
        <input type="checkbox" name="consent" data-consent />
        <span>Tengo 14 años o más, he leído la <a href="/privacidad" target="_blank">Política de Privacidad</a>{' '}y las{' '}<a href="/condiciones" target="_blank">Condiciones</a>, y quiero recibir la newsletter de POYAGORDA.</span>
      </label>
      <div class="term__hp" aria-hidden="true">
        <label>Web <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>

      <button type="submit" class="btn term__submit" data-submit>Meterme dentro</button>
      <p class="term__note" data-note></p>
      <p class="term__legal">
        <strong>Responsable:</strong>{' '}POYAGORDA (identificación completa en el <a href="/aviso-legal" target="_blank">Aviso legal</a>).{' '}
        <strong>Finalidad:</strong>{' '}enviarte la newsletter y novedades de POYAGORDA.{' '}
        <strong>Legitimación:</strong>{' '}tu consentimiento.{' '}
        <strong>Destinatarios:</strong>{' '}{newsletterProcessor.name}, como encargado del tratamiento.{' '}
        <strong>Derechos:</strong>{' '}acceso, rectificación, supresión y demás, escribiendo a <a href={`mailto:${legal.email}`}>{legal.email}</a>.{' '}
        Más info en la <a href="/privacidad" target="_blank">Política de Privacidad</a>.
      </p>
    </form>
  </template>

  <div class="inside" data-inside hidden role="dialog" aria-modal="true" aria-labelledby="inside-title">
    <div class="inside__inner">
      <p class="inside__brand">POYAGORDA<span>.</span></p>
      <h2 id="inside-title" class="display inside__title" data-inside-title>Estás dentro.</h2>
      <p class="inside__msg" data-inside-msg></p>
      <button type="button" class="btn inside__close" data-inside-close>Vale, pesados</button>
    </div>
  </div>
</section>

<style>
  .gate {
    position: relative;
    padding: clamp(70px, 10vw, 140px) 0 clamp(80px, 11vw, 150px);
  }

  .gate__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(36px, 6vw, 90px);
    align-items: start;
  }

  .gate__head {
    position: sticky;
    top: calc(var(--header-h) + 40px);
  }

  .gate__title {
    margin-top: 18px;
    font-size: clamp(38px, 5vw, 74px);
    font-stretch: 85%;
  }

  .gate__sub {
    max-width: 440px;
    margin-top: 24px;
    color: var(--muted);
  }

  /* Terminal */
  .term {
    position: relative;
    border: 1px solid var(--line);
    background: linear-gradient(180deg, #0b0b0b, #070707);
    box-shadow: 0 40px 120px rgb(0 0 0 / 0.7), 0 0 0 1px rgb(249 222 49 / 0.02) inset;
    font-family: var(--font-mono);
    font-size: clamp(14px, 1.05vw, 16px);
    line-height: 1.6;
  }

  .term::before {
    /* líneas de escaneo muy sutiles */
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(0deg, rgb(255 255 255 / 0.018) 0 1px, transparent 1px 3px);
  }

  .term__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 44px;
    padding: 0 16px;
    border-bottom: 1px solid var(--line);
    color: var(--dim);
    font-size: 12px;
  }

  .term__path {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .term__reset {
    flex: none;
    min-height: 36px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .term__reset:hover {
    color: var(--yellow);
  }

  .term__reset[hidden] {
    display: none;
  }

  .term__screen {
    position: relative;
    display: flex;
    flex-direction: column;
    height: clamp(460px, 70svh, 660px);
    padding: 20px clamp(16px, 2.4vw, 28px) 18px;
  }

  .term__log {
    flex: 1 1 auto;
    min-height: 90px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--dim) transparent;
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 28px);
    mask-image: linear-gradient(180deg, transparent 0, #000 28px);
    padding-top: 22px;
  }

  .term__controls {
    flex: none;
    max-height: 72%;
    overflow-y: auto;
    padding-top: 14px;
  }

  .term__controls:has(.term__consent) {
    max-height: 86%;
  }

  .term__boot {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    min-height: 52px;
    padding: 0 14px;
    border: 1px dashed var(--dim);
    background: transparent;
    color: var(--white);
    font-family: var(--font-mono);
    text-align: left;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .term__boot:hover {
    border-color: var(--yellow);
  }

  .term__caret {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    background: var(--yellow);
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .term__noscript {
    padding: 20px;
    color: var(--yellow);
  }

  /* Overlay final */
  .inside {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: grid;
    place-items: center;
    padding: var(--gutter);
    background: var(--yellow);
    color: var(--black);
    clip-path: circle(0 at var(--ox, 50%) var(--oy, 50%));
    transition: clip-path 0.9s cubic-bezier(0.7, 0, 0.2, 1);
  }

  .inside[hidden] {
    display: none;
  }

  .inside.is-open {
    clip-path: circle(150vmax at var(--ox, 50%) var(--oy, 50%));
  }

  .inside__inner {
    width: min(100%, 900px);
  }

  .inside__brand {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 20px;
    letter-spacing: -0.05em;
  }

  .inside__title {
    margin-top: 18px;
    font-size: clamp(56px, 12vw, 180px);
    font-stretch: 110%;
    letter-spacing: -0.06em;
  }

  .inside__msg {
    max-width: 620px;
    margin-top: 24px;
    font-size: clamp(18px, 1.8vw, 24px);
    line-height: 1.35;
    font-weight: 500;
  }

  .inside__close {
    --bg: var(--black);
    --fg: var(--yellow);
    margin-top: 36px;
  }

  .inside__close:hover {
    background: var(--white);
    color: var(--black);
  }

  @media (max-width: 960px) {
    .gate__inner {
      grid-template-columns: 1fr;
    }

    .gate__head {
      position: static;
    }
  }

  @media (max-width: 520px) {
    /* Con el formulario delante, la terminal crece para que todo se vea sin scroll interno. */
    .term__screen:has(.term__consent) {
      height: auto;
    }

    .term__screen:has(.term__consent) .term__log {
      max-height: 46svh;
    }

    .term__screen:has(.term__consent) .term__controls {
      max-height: none;
      overflow: visible;
    }

    .term {
      margin-inline: calc(var(--gutter) * -1);
      border-inline: 0;
    }

    .term__screen {
      height: clamp(440px, 76svh, 640px);
    }
  }
</style>

<style is:global>
  /* Piezas que crea el script: necesitan estilos globales. */
  .t-line {
    margin: 0 0 0.55em;
    white-space: pre-wrap;
    color: var(--white);
  }

  .t-line::before {
    content: '> ';
    color: var(--yellow);
  }

  .t-sys {
    color: var(--muted);
  }

  .t-sys::before {
    content: '// ';
    color: var(--dim);
  }

  .t-you {
    color: var(--yellow);
  }

  .t-you::before {
    content: 'tú: ';
    color: var(--muted);
  }

  .t-err {
    color: var(--yellow);
  }

  .t-err::before {
    content: '!! ';
  }

  .t-ask {
    margin-top: 1.1em;
    font-weight: 700;
  }

  .t-gap {
    height: 0.6em;
  }

  .t-line.is-typing::after {
    content: '';
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 2px;
    vertical-align: -0.18em;
    background: var(--yellow);
  }

  .t-options {
    display: grid;
    gap: 8px;
  }

  .t-opt {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 48px;
    padding: 10px 14px;
    border: 1px solid var(--line);
    background: rgb(255 255 255 / 0.015);
    color: var(--white);
    font-family: var(--font-mono);
    font-size: inherit;
    text-align: left;
    opacity: 0;
    transform: translateY(6px);
    animation: t-in 0.35s var(--ease-out) forwards;
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
  }

  .t-opt:nth-child(2) {
    animation-delay: 0.06s;
  }

  .t-opt:nth-child(3) {
    animation-delay: 0.12s;
  }

  .t-opt:hover,
  .t-opt:focus-visible {
    border-color: var(--yellow);
    background: rgb(249 222 49 / 0.06);
    color: var(--yellow);
    outline: none;
  }

  .t-opt kbd {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border: 1px solid var(--dim);
    color: var(--muted);
    font-family: inherit;
    font-size: 12px;
  }

  @keyframes t-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .t-form {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 4px 4px 4px 14px;
    border: 1px solid var(--dim);
    animation: t-in 0.35s var(--ease-out) both;
    transition: border-color 0.2s ease;
  }

  .t-form:focus-within {
    border-color: var(--yellow);
  }

  .t-form__prompt {
    flex: none;
    color: var(--yellow);
  }

  .t-form input {
    flex: 1 1 auto;
    min-width: 0;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--white);
    font-family: var(--font-mono);
    font-size: max(16px, 1em);
    caret-color: var(--yellow);
    outline: none;
  }

  .t-form input::placeholder {
    color: var(--dim);
  }

  .t-form__send {
    flex: none;
    min-height: 44px;
    padding: 0 14px;
    border: 0;
    background: var(--yellow);
    color: var(--black);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
  }

  .t-form__send:hover {
    background: var(--white);
  }

  .term__consent {
    display: grid;
    gap: 14px;
    animation: t-in 0.35s var(--ease-out) both;
  }

  .term__check {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 12px;
    align-items: start;
    padding: 14px;
    border: 1px solid var(--dim);
    font-size: 13px;
    line-height: 1.5;
    color: var(--white);
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .term__check:has(input:checked) {
    border-color: var(--yellow);
  }

  .term__check.is-wrong {
    border-color: var(--yellow);
    animation: shake 0.4s ease;
  }

  @keyframes shake {
    25% { transform: translateX(-6px); }
    50% { transform: translateX(5px); }
    75% { transform: translateX(-3px); }
  }

  .term__check input {
    width: 20px;
    height: 20px;
    margin: 1px 0 0;
    accent-color: var(--yellow);
    cursor: pointer;
  }

  .term__check a,
  .term__legal a {
    color: var(--yellow);
  }

  .term__legal {
    font-size: 11px;
    line-height: 1.55;
    color: var(--muted);
  }

  .term__legal strong {
    color: #b9b8b1;
    font-weight: 600;
  }

  .term__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .term__email[hidden] {
    display: none;
  }

  .term__note {
    margin-top: -6px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
  }

  .term__note:empty {
    display: none;
  }

  .t-cta {
    color: var(--yellow);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .t-cta::before {
    content: '';
  }

  .term__submit {
    width: 100%;
  }

  .term__submit[disabled] {
    opacity: 0.6;
    cursor: progress;
  }
</style>

<script>
  import { initGate } from '../scripts/gate';
  initGate();
</script>
