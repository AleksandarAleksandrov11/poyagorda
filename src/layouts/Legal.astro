---
import Base from './Base.astro';
import { legal } from '../config/site';

interface Props {
  title: string;
  kicker: string;
  description: string;
}
const { title, kicker, description } = Astro.props;
---

<Base title={`${title} | POYAGORDA`} description={description}>
  <article class="legal container">
    <header class="legal__head">
      <a class="legal__back" href="/">Volver</a>
      <p class="eyebrow">{kicker}</p>
      <h1 class="display legal__title">{title}</h1>
      <p class="legal__date">Última actualización: {legal.updatedAt}</p>
    </header>
    <div class="legal__body">
      <slot />
    </div>
  </article>
</Base>

<style>
  .legal {
    max-width: 820px;
    padding: clamp(40px, 7vw, 90px) 0 clamp(70px, 9vw, 120px);
  }

  .legal__back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-bottom: 26px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
  }

  .legal__back::before {
    content: '<';
    margin-right: 8px;
    color: var(--yellow);
  }

  .legal__back:hover {
    color: var(--yellow);
  }

  .legal__title {
    margin-top: 16px;
    font-size: clamp(40px, 7vw, 84px);
    font-stretch: 82%;
  }

  .legal__date {
    margin-top: 18px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .legal__body {
    margin-top: clamp(36px, 5vw, 56px);
    color: #c9c8c1;
    font-size: 16px;
    line-height: 1.7;
  }

  .legal__body :global(h2) {
    margin: 2.4em 0 0.7em;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--white);
  }

  .legal__body :global(p),
  .legal__body :global(ul),
  .legal__body :global(table) {
    margin: 0 0 1em;
  }

  .legal__body :global(ul) {
    padding-left: 1.2em;
  }

  .legal__body :global(li) {
    margin-bottom: 0.4em;
  }

  .legal__body :global(a) {
    color: var(--yellow);
  }

  .legal__body :global(strong) {
    color: var(--white);
  }

  .legal__body :global(.lead) {
    font-size: 18px;
    color: var(--white);
  }

  .legal__body :global(.table-wrap) {
    overflow-x: auto;
    margin: 0 0 1.2em;
  }

  .legal__body :global(table) {
    width: 100%;
    min-width: 520px;
    border-collapse: collapse;
    font-size: 14px;
  }

  .legal__body :global(th),
  .legal__body :global(td) {
    padding: 10px 12px;
    border: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .legal__body :global(th) {
    color: var(--white);
    background: var(--ink-2);
    font-weight: 700;
  }
</style>
