---
import Base from '../layouts/Base.astro';
---

<Base title="Enlace caducado | POYAGORDA" description="Este enlace ya no vale." noindex>
  <section class="msg container">
    <p class="eyebrow">Enlace caducado.</p>
    <h1 class="display msg__title">Llegas<br /><span class="y">tarde.</span></h1>
    <p class="msg__text">Este enlace ha caducado o no es válido. No pasa nada: vuelve a apuntarte y te mandamos otro.</p>
    <a class="btn" href="/#entrar">Volver a intentarlo</a>
  </section>
</Base>

<style>
  .msg {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-height: calc(100svh - var(--header-h) - 160px);
    padding: 60px 0;
  }

  .msg__title {
    margin-top: 18px;
    font-size: clamp(48px, 10vw, 140px);
    font-stretch: 95%;
  }

  .msg__text {
    max-width: 520px;
    margin: 26px 0 36px;
    color: var(--muted);
    font-size: 18px;
  }
</style>
