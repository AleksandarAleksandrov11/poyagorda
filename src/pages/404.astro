---
import Base from '../layouts/Base.astro';
---

<Base title="404 | POYAGORDA" description="Aquí no hay nada." noindex>
  <section class="nf container">
    <p class="eyebrow">Error 404.</p>
    <h1 class="display nf__title">Aquí no hay<br /><span class="y">una mierda.</span></h1>
    <p class="nf__text">Te has perdido, figura. O alguien te ha pasado un enlace roto. En cualquier caso, la puerta buena está por aquí.</p>
    <a class="btn" href="/">Llévame a casa</a>
  </section>
</Base>

<style>
  .nf {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-height: calc(100svh - var(--header-h) - 160px);
    padding: 60px 0;
  }

  .nf__title {
    margin-top: 18px;
    font-size: clamp(48px, 10vw, 140px);
    font-stretch: 95%;
  }

  .nf__text {
    max-width: 520px;
    margin: 26px 0 36px;
    color: var(--muted);
    font-size: 18px;
  }
</style>
