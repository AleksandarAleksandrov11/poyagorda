---
import Base from '../layouts/Base.astro';
---

<Base title="Confirmado | POYAGORDA" description="Suscripción confirmada." noindex>
  <section class="msg container">
    <p class="eyebrow">Suscripción confirmada.</p>
    <h1 class="display msg__title">Ya eres<br /><span class="y">de los nuestros.</span></h1>
    <p class="msg__text">Cuando haya algo gordo que contar, serás de los primeros en saberlo. Mientras tanto, ni una palabra a nadie.</p>
    <a class="btn" href="/">Volver al sótano</a>
  </section>
</Base>

<style>
  .msg {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-height: calc(100svh - var(--header-h) - 160px);
    padding: 60px 0;
  }

  .msg__title {
    margin-top: 18px;
    font-size: clamp(48px, 10vw, 140px);
    font-stretch: 95%;
  }

  .msg__text {
    max-width: 520px;
    margin: 26px 0 36px;
    color: var(--muted);
    font-size: 18px;
  }
</style>
