# Copia esto en Vercel > Project > Settings > Environment Variables (no subas un .env real al repo).

# URL pública con dominio propio (opcional; en Vercel se detecta sola).
SITE_URL=https://poyagorda.com

# Proveedor de newsletter: brevo | mailerlite | webhook
NEWSLETTER_PROVIDER=brevo

# --- Brevo (recomendado) ---
BREVO_API_KEY=
BREVO_LIST_ID=
# Doble opt-in propio (recomendado): la web manda un correo con tu diseño (emails/confirmacion.html)
# y el contacto solo entra en la lista al pulsar el enlace. Pon un texto largo y aleatorio.
CONFIRM_SECRET=
# Remitente verificado en Brevo y dirección de respuesta (opcionales, estos son los valores por defecto).
BREVO_SENDER_EMAIL=marketing@poyagorda.com
BREVO_REPLY_TO=cuentanos@poyagorda.com
# Alternativa: plantilla DOI nativa de Brevo. Si la pones, tiene preferencia sobre CONFIRM_SECRET.
BREVO_DOI_TEMPLATE_ID=

# --- MailerLite (alternativa) ---
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
# true si tienes activado el doble opt-in para API en MailerLite.
MAILERLITE_DOUBLE_OPTIN=true

# --- Webhook (opcional) ---
# Con NEWSLETTER_PROVIDER=webhook es el único destino. Con otro proveedor, recibe una copia
# (útil para guardar las respuestas del cuestionario en Google Sheets, Make, Zapier, n8n...).
NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_SECRET=
