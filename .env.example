# Copia esto en Vercel > Project > Settings > Environment Variables (no subas un .env real al repo).

# URL pública con dominio propio (opcional; en Vercel se detecta sola).
SITE_URL=https://poyagorda.com

# Proveedor de newsletter: brevo | mailerlite | webhook
NEWSLETTER_PROVIDER=brevo

# --- Brevo (recomendado) ---
BREVO_API_KEY=
BREVO_LIST_ID=
# Plantilla de doble opt-in (Brevo > Campañas > Plantillas, con el enlace {{ doubleoptin }}).
# Si la dejas vacía, el contacto se añade directamente sin confirmación.
BREVO_DOI_TEMPLATE_ID=
# A dónde va la gente tras confirmar (por defecto https://tu-dominio/confirmado).
BREVO_DOI_REDIRECT_URL=

# --- MailerLite (alternativa) ---
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
# true si tienes activado el doble opt-in para API en MailerLite.
MAILERLITE_DOUBLE_OPTIN=true

# --- Webhook (opcional) ---
# Con NEWSLETTER_PROVIDER=webhook es el único destino. Con otro proveedor, recibe una copia
# (útil para guardar las respuestas del cuestionario en Google Sheets, Make, Zapier, n8n...).
NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_SECRET=
